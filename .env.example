OPENAI_API_KEY=sk-...

# Model profile — see covenant_agent/llm_client.py's "Model profiles" docstring.
# "dev": mini/nano tier for all three call types (default; no token budget concern).
# "final": top-tier for covenant extraction + transaction categorization,
#          mini tier for fact extraction. Reserve for the Aug 9 calibration/final runs.
# COVENANT_AGENT_PROFILE=dev

# Optional per-call-type overrides — take precedence over the profile default.
# COVENANT_AGENT_MODEL_COVENANT_EXTRACTION=gpt-5.4
# COVENANT_AGENT_MODEL_TRANSACTION_CATEGORIZATION=gpt-5.4
# COVENANT_AGENT_MODEL_FACT_EXTRACTION=gpt-5.4-mini
